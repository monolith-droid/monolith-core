{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONOLITH Core Knowledge Index",
  "type": "object",
  "required": ["index_id", "entries"],
  "additionalProperties": false,
  "properties": {
    "index_id": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["card_id", "path", "tags"],
        "additionalProperties": false,
        "properties": {
          "card_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "tags": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  }
}
