{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONOLITH Core Memory Scorecard",
  "type": "object",
  "required": [
    "scorecard_id",
    "passed",
    "status",
    "mode",
    "mutation_performed",
    "root",
    "as_of",
    "overall_score",
    "score_count",
    "low_score_count",
    "scores",
    "blockers",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "scorecard_id": {
      "type": "string",
      "pattern": "^scorecard-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "passed": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["scorecard_ready", "scorecard_needs_growth"]
    },
    "mode": {
      "type": "string",
      "enum": ["report_only"]
    },
    "mutation_performed": { "type": "boolean", "const": false },
    "root": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "overall_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "score_count": { "type": "integer", "minimum": 1 },
    "low_score_count": { "type": "integer", "minimum": 0 },
    "scores": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "score_id",
          "title",
          "score",
          "threshold",
          "status",
          "source_refs",
          "evidence",
          "next_action"
        ],
        "additionalProperties": false,
        "properties": {
          "score_id": {
            "type": "string",
            "pattern": "^score-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "threshold": { "type": "number", "minimum": 0, "maximum": 100 },
          "status": {
            "type": "string",
            "enum": ["pass", "needs_growth"]
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "evidence": { "type": "object" },
          "next_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
