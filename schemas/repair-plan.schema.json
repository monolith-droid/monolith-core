{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONOLITH Core Repair Plan",
  "type": "object",
  "required": [
    "repair_plan_id",
    "passed",
    "status",
    "mode",
    "mutation_performed",
    "root",
    "as_of",
    "source_status",
    "source_passed",
    "source_refs",
    "repair_step_count",
    "repair_steps",
    "blockers",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "repair_plan_id": {
      "type": "string",
      "pattern": "^repair-plan-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "passed": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["repair_plan_ready", "repair_not_needed"]
    },
    "mode": {
      "type": "string",
      "enum": ["report_only"]
    },
    "mutation_performed": { "type": "boolean", "const": false },
    "root": { "type": "string", "minLength": 1 },
    "as_of": { "type": "string", "format": "date" },
    "source_status": { "type": "string", "minLength": 1 },
    "source_passed": { "type": "boolean" },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "repair_step_count": { "type": "integer", "minimum": 0 },
    "repair_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repair_step_id",
          "title",
          "severity",
          "source_refs",
          "evidence",
          "recommended_action"
        ],
        "additionalProperties": false,
        "properties": {
          "repair_step_id": {
            "type": "string",
            "pattern": "^repair-step-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "evidence": { "type": "object" },
          "recommended_action": { "type": "string", "minLength": 1 }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
