{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MONOLITH Core Growth Idea Queue",
  "type": "object",
  "required": [
    "queue_id",
    "generated_at",
    "mode",
    "mutation_performed",
    "source_refs",
    "ideas"
  ],
  "additionalProperties": false,
  "properties": {
    "queue_id": {
      "type": "string",
      "pattern": "^queue-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "generated_at": { "type": "string", "format": "date" },
    "mode": {
      "type": "string",
      "enum": ["report_only"]
    },
    "mutation_performed": { "type": "boolean", "const": false },
    "source_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "idea_id",
          "title",
          "summary",
          "source_refs",
          "status",
          "public_safety",
          "impact",
          "effort",
          "confidence",
          "next_action"
        ],
        "additionalProperties": false,
        "properties": {
          "idea_id": {
            "type": "string",
            "pattern": "^idea-[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1
          },
          "status": {
            "type": "string",
            "enum": ["adopted", "candidate", "deferred"]
          },
          "public_safety": {
            "type": "string",
            "enum": ["generalized", "synthetic"]
          },
          "impact": { "type": "integer", "minimum": 1, "maximum": 5 },
          "effort": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confidence": { "type": "integer", "minimum": 1, "maximum": 5 },
          "next_action": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
